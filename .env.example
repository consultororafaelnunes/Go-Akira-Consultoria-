# ── Claude (sumarização) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth (Gmail + Drive) ───────────────────────────────────────
# CLIENT_ID e CLIENT_SECRET vêm do Google Cloud Console (credencial OAuth "App de computador").
# REFRESH_TOKEN é gerado rodando:  python get_refresh_token.py
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# ── Email (envio do resumo diário) ─────────────────────────────────────
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=senha-de-app-do-gmail
RECIPIENT_EMAIL=destino@email.com
SENDER_NAME=Agente de Reuniões
SMTP_HOST=smtp.gmail.com

# ── Opcionais ──────────────────────────────────────────────────────────
# Pasta raiz no Drive onde ficam as pastas dos clientes (vazio = My Drive)
DRIVE_ROOT_FOLDER_ID=
# Dia do mês para o relatório mensal (padrão: 1)
MONTHLY_REPORT_DAY=1
